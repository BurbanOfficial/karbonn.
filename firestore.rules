rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vérifie si l'utilisateur connecté est Manager
    function isManager() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Manager';
    }

    // Vérifie si l'utilisateur connecté est l'auteur du document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Configuration publique : indique si le setup initial est terminé
    match /config/setupComplete {
      allow read: if true;
      allow write: if isManager();
    }

    // Collection users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if isOwner(userId) || isManager();
      // Un utilisateur peut modifier certains de ses propres champs (préférences, première connexion) ; le reste est réservé aux managers
      allow update: if isManager() ||
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['themePreference', 'firstLogin']));
      allow delete: if isManager();

      // Historique des connexions/déconnexions de l'utilisateur
      match /sessions/{sessionId} {
        allow read: if isOwner(userId) || isManager();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // Collection roles
    match /roles/{roleId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isManager();
    }

    // Collection statuses
    match /statuses/{statusId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isManager();
    }

    // Collection clients
    match /clients/{clientId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isManager();
    }

    // Collection projets
    match /projets/{projetId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;

      match /notes/{noteId} {
        allow read, create: if request.auth != null;
        allow update, delete: if false;
      }

      match /validationHistory/{validationId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }
    }

    // Collection billings (Facturation & Devis)
    match /billings/{billingId} {
      allow read, create, update, delete: if isManager();
    }

    // Collection activity_log (historique des actions)
    match /activity_log/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Collection settings (grille tarifaire, etc.)
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isManager();
    }

    // Le statut de maintenance doit rester lisible publiquement (espace client sans authentification Firebase)
    match /settings/maintenance {
      allow read: if true;
      allow create, update, delete: if isManager();
    }

    // Journal des actions de maintenance (activation, désactivation, planification)
    match /maintenanceLogs/{logId} {
      allow read: if isManager();
      allow create: if isManager();
      allow update, delete: if false;
    }

    // Collection abonnements (subscription plans)
    match /abonnements/{aboId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isManager();
    }

    // Collection sitesWeb (gestion des sites web)
    match /sitesWeb/{siteId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isManager();

      match /history/{historyId} {
        allow read: if request.auth != null;
        allow create: if isManager() ||
          (request.auth != null && request.resource.data.type == 'note');
        allow update: if isManager() ||
          (request.auth != null &&
            resource.data.type == 'note' &&
            request.resource.data.type == 'note' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content']));
        allow delete: if isManager();
      }
    }
  }
}
